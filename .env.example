# Configuração do Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Configuração do Banco de Dados PostgreSQL
DATABASE_URL=postgresql://ged_user:ged_password@localhost:5432/ged_db?client_encoding=utf8

# Configuração da API de IA (DeepSeek)
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-96ebed7e493443b5b11be8bd83448d28
AI_API_TIMEOUT=30
AI_API_MODEL=deepseek-chat

# Configurações de Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/uploads/documentos
PUBLISHED_FOLDER=app/uploads/publicados

# Configurações de Documentos
VALIDADE_PADRAO_ANOS=5
DIAS_ALERTA_VENCIMENTO=30

# Configurações de E-mail (SMTP)
# Para Gmail: smtp.gmail.com, porta 587, TLS ativado
# Para Outlook: smtp.office365.com, porta 587, TLS ativado
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=noreply@ged.com

# URL do aplicativo (usado nos links dos e-mails)
APP_URL=http://localhost:5000
