# Configuração do Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Configuração do Banco de Dados PostgreSQL
DATABASE_URL=postgresql://ged_user:ged_password@localhost:5432/ged_db?client_encoding=utf8

# Configuração da API de IA (DeepSeek)
# IMPORTANTE: NUNCA coloque sua chave real aqui! Este arquivo é versionado no Git.
# Configure a chave real no arquivo .env (que não é versionado)
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key-here
AI_API_TIMEOUT=30
AI_API_MODEL=deepseek-chat

# Configurações de Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/uploads/documentos
PUBLISHED_FOLDER=app/uploads/publicados

# Configurações de Documentos
VALIDADE_PADRAO_ANOS=5
DIAS_ALERTA_VENCIMENTO=30

# Configurações de E-mail (SMTP)
# Para Gmail: smtp.gmail.com, porta 587, TLS ativado
# Para Outlook: smtp.office365.com, porta 587, TLS ativado
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=noreply@ged.com

# URL do aplicativo (usado nos links dos e-mails)
APP_URL=http://localhost:5000

# ============================================================================
# Configurações do WhatsApp (Evolution API - Open Source)
# ============================================================================
# IMPORTANTE: Configure também no painel /admin/whatsapp
# Tutorial completo: Veja GUIA_EVOLUTION_API.md

# Evolution API (gratuita e open-source)
# Instale seguindo: https://github.com/EvolutionAPI/evolution-api
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=minha_instancia
EVOLUTION_API_KEY=sua-api-key-aqui

# Nota 1: As configurações acima são opcionais. O WhatsApp pode ser configurado
# totalmente pelo painel administrativo em /admin/whatsapp

# Nota 2: A Evolution API é gratuita, sem burocracias e suporta múltiplas instâncias
# Você pode hospedá-la no seu próprio servidor ou usar serviços como Railway, Render, etc.

# ============================================================================
# Configurações do WhatsApp (Twilio - DEPRECATED)
# ============================================================================
# ATENÇÃO: Twilio foi descontinuado em favor da Evolution API
# Mantido apenas para compatibilidade retroativa

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_WHATSAPP_NUMBER=+14155238886
