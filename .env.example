# ============================================
# VARIÁVEIS DE AMBIENTE - SISTEMA GED EBSERH
# ============================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha TODAS as variáveis abaixo
# 3. NUNCA faça commit do arquivo .env
#
# ============================================

# ==========================================
# AMBIENTE
# ==========================================
FLASK_ENV=production
FLASK_APP=app.py

# ==========================================
# SEGURANÇA (OBRIGATÓRIO)
# ==========================================
# Gere com: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=GERE_UMA_CHAVE_SEGURA_AQUI_COM_64_CARACTERES_HEXADECIMAIS

# ==========================================
# BANCO DE DADOS (OBRIGATÓRIO)
# ==========================================
DB_PASSWORD=SENHA_SUPER_SEGURA_DO_POSTGRES
DATABASE_URL=postgresql://ged_user:SENHA_DO_POSTGRES@db:5432/ged_db

# ==========================================
# REDIS (OBRIGATÓRIO)
# ==========================================
REDIS_PASSWORD=SENHA_SUPER_SEGURA_DO_REDIS

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (DeepSeek)
# ==========================================
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_API_MODEL=deepseek-chat
AI_API_TIMEOUT=30

# ==========================================
# EMAIL (SMTP)
# ==========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_gmail
MAIL_DEFAULT_SENDER=noreply@ged.ebserh.gov.br

# ==========================================
# WHATSAPP (Evolution API) - OPCIONAL
# ==========================================
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=SUA_CHAVE_DA_EVOLUTION_API
EVOLUTION_INSTANCE_NAME=ged-instance

# ==========================================
# BACKUP (CRIPTOGRAFIA)
# ==========================================
BACKUP_ENCRYPTION_KEY=GERE_UMA_CHAVE_FERNET_AQUI

# ==========================================
# PORTAS
# ==========================================
WEB_PORT=5000
DB_PORT=5432
