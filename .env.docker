# ============================================
# Variáveis de Ambiente - Docker
# ============================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.docker .env
# 2. Edite os valores conforme necessário
# 3. NUNCA commite o arquivo .env
# ============================================

# ==========================================
# Flask
# ==========================================
FLASK_ENV=production
FLASK_APP=app.py

# ==========================================
# Segurança
# ==========================================
# OBRIGATÓRIO: Gere uma chave secreta forte!
# Gere com: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_print_secrets_token_hex_32

# ==========================================
# Banco de Dados
# ==========================================
DB_PASSWORD=ged_password_CHANGE_IN_PRODUCTION
DB_PORT=5432

# ==========================================
# Portas
# ==========================================
WEB_PORT=5000
EVOLUTION_PORT=8080

# ==========================================
# AI (DeepSeek)
# ==========================================
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_API_MODEL=deepseek-chat
AI_API_TIMEOUT=30

# ==========================================
# Email (SMTP)
# ==========================================
# Gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=noreply@ged.com

# Outlook/Hotmail
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587

# ==========================================
# WhatsApp (Evolution API) - OPCIONAL
# ==========================================
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=sua-chave-super-secreta
EVOLUTION_INSTANCE_NAME=ged-instance
