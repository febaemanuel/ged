# ============================================
# .dockerignore - Sistema GED EBSERH
# ============================================

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Ambiente
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Uploads (serão criados no container)
app/uploads/documentos/*
app/uploads/publicados/*
uploads/assinaturas/*
!app/uploads/documentos/.gitkeep
!app/uploads/publicados/.gitkeep
!uploads/assinaturas/.gitkeep

# Testes
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Documentação
docs/_build/
*.md
!README.md

# Docker
docker-compose.override.yml
.dockerignore
Dockerfile

# Scripts
setup.sh
setup.bat

# Outros
*.bak
*.tmp
*.temp
migrations/
